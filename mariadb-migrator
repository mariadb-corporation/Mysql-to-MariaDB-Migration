  cat <<'EOF'

The 'staged' mode runs as two phases (dump from source, load to target).
The phases can run together (default) or separately:

  dump_and_load   Dump from source, then load to target on this host.
  dump_only       Dump from source to a file, then exit. Use this when
                  the load will happen later or on a different host.
  load_only       Load an existing dump into target. Skip the source
                  connection entirely; STAGED_DUMP_DIR must point at the
                  directory containing manifest.txt.

EOF
  STAGED_PHASE="$(prompt "Phase (dump_and_load|dump_only|load_only)" "dump_and_load")"
  STAGED_PHASE="${STAGED_PHASE// /}"
  if [[ "$STAGED_PHASE" != "dump_and_load" && "$STAGED_PHASE" != "dump_only" && "$STAGED_PHASE" != "load_only" ]]; then
    echo "ERROR: STAGED_PHASE must be dump_and_load, dump_only, or load_only"
    exit 1
  fi

  # Offline-migration acknowledgment. Skip for load_only (the source is no
  # longer in scope at load time).
  if [[ "$STAGED_PHASE" != "load_only" ]]; then
    cat <<'EOF'

==============================================================================
  IMPORTANT: STAGED MODE IS AN OFFLINE MIGRATION

  Writes to the SOURCE database during the dump WILL NOT be captured and may
  be lost when the data is loaded on the target. To ensure a consistent
  cutover:

    - Stop application traffic to the source BEFORE proceeding.
    - Confirm no other writers (cron jobs, replication, batch jobs).
    - Resume traffic on the TARGET only after the load completes.

  If you cannot afford application downtime, abort now and use 'binlog' mode.
==============================================================================

EOF
    if [[ -z "$STAGED_CONFIRM_OFFLINE" ]]; then
      ack="$(prompt "Have you stopped writes to the source? (y/n)" "n")"
      if [[ "$(printf "%s" "$ack" | tr '[:upper:]' '[:lower:]')" != "y" ]]; then
        echo "Aborting. Stop application traffic to the source, then re-run."
        exit 1
      fi
    else
      echo "==> Offline acknowledgment supplied via STAGED_CONFIRM_OFFLINE."
    fi
  fi

  # For load_only: prompt for STAGED_DUMP_DIR. Auto-detect the most recent
  # artifacts/run_staged_*/dumps with a manifest.txt as the default, so the
  # common "dump now, load later, same host" workflow is one Enter press.
  if [[ "$STAGED_PHASE" == "load_only" ]]; then
