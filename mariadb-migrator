prompt() {
  local label="$1"
  local def="${2:-}"
  local var
  if [[ -n "$def" ]]; then
    read -r -p "$label [$def]: " var
    printf "%s" "${var:-$def}"
  else
    read -r -p "$label: " var
    printf "%s" "$var"
  fi
}

prompt_secret() {
  local label="$1"
  local var
  read -r -s -p "$label: " var
  printf "\n"
  printf "%s" "$var"
}

confirm_proceed() {
  local label="$1"
  local default_ans="${2:-y}"
  local ans
  ans="$(prompt "$label (y/n)" "$default_ans")"
  ans="$(printf "%s" "$ans" | tr '[:upper:]' '[:lower:]')"
  [[ "$ans" == "y" ]]
}

# --- User-facing mode labels ------------------------------------------------
# Map the internal mode identifier (one_step / two_step / staged / binlog) to
# the descriptive label shown in the menu and completion banners. The internal
# identifiers remain the canonical form in config/migration.yaml, env vars,
# state.json, and the orchestrator API — only the display text changes.
mode_label() {
  case "$1" in
    one_step)      printf "%s" "Serial Streaming Copy (mariadb-dump)" ;;
    two_step)      printf "%s" "Parallel Restartable Streaming Copy (sqldata)" ;;
    staged)        printf "%s" "Offline Copy (mariadb-dump)" ;;
    binlog)        printf "%s" "Replication (binlog)" ;;
    inplace)       printf "%s" "In-place upgrade" ;;
    replace_slave) printf "%s" "Replace slave" ;;
    *)             printf "%s" "$1" ;;
  esac
}

# --- Interactive mode selection (top-level + sub-menus) ---------------------
# Top-level menu: presents the four primary modes as a numbered list, with
# 'd' to expand to the detailed descriptions (caveats, disk, version notes)
# and 'q' to quit. Loops on invalid input. Sets $MODE and returns 0; calls
# exit on quit. Hidden modes (inplace, replace_slave) are reachable only by
# setting MODE in the environment before invocation.
prompt_mode_selection() {
  local choice
  while true; do
    print_modes_briefing
    cat <<'EOF'
  d) Show detailed descriptions (caveats, disk requirements, version notes)
  b) Back to top-level menu
  q) Quit

EOF
    read -r -p "Enter choice [1-4, d, b, q]: " choice
    case "$choice" in
      1)   MODE="one_step"; return 0 ;;
      2)   MODE="two_step"; return 0 ;;
      3)   MODE="staged";   return 0 ;;
      4)   MODE="binlog";   return 0 ;;
      d|D) print_modes_detailed ;;
      b|B) MODE_SELECT_BACK=1; return 0 ;;
      q|Q) echo "Cancelled."; exit 0 ;;
      "")  echo "Please enter a choice." ;;
      *)   echo "Invalid choice: '$choice'. Please enter 1, 2, 3, 4, d, b, or q." ;;
    esac
  done
}

# Staged phase sub-menu. Returns 0 with $STAGED_PHASE set, or 1 to signal
# "back to top-level mode menu". Exits on 'q'. Bare Enter accepts option 1
# (dump_and_load) — the safe common case.
prompt_staged_phase() {
  local choice
  while true; do
    cat <<'EOF'

Offline Copy (mariadb-dump) — select phase:

  1) Dump and load          Full end-to-end on this host (default).
  2) Dump only              Produce dump files on disk, then exit. Use this
                            when the load will happen later or on a
                            different host.
  3) Load only              Load an existing dump into the target. Skip the
                            source connection entirely; STAGED_DUMP_DIR must
                            point at the directory containing manifest.txt.

  b) Back to mode selection
  q) Quit

EOF
    read -r -p "Enter choice [1-3, b, q, Enter=1]: " choice
    case "$choice" in
      ""|1) STAGED_PHASE="dump_and_load"; return 0 ;;
      2)    STAGED_PHASE="dump_only";     return 0 ;;
      3)    STAGED_PHASE="load_only";     return 0 ;;
      b|B)  return 1 ;;
      q|Q)  echo "Cancelled."; exit 0 ;;
      *)    echo "Invalid choice: '$choice'. Please enter 1, 2, 3, b, or q." ;;
    esac
  done
}

# Mode selection with sub-menu for the staged phase.
# 'b' from a sub-menu returns to the top-level so the operator can pick a
# different top-level mode without restarting. Sets $MODE (and possibly
# $STAGED_PHASE). Used both at first invocation and on re-prompt after a
# source-side compatibility check rejects the choice.
prompt_mode_with_submenus() {
  while true; do
    MODE_SELECT_BACK=0
    prompt_mode_selection  # sets $MODE; exits the script on 'q'; sets MODE_SELECT_BACK=1 on 'b'
    if [[ "$MODE_SELECT_BACK" == "1" ]]; then
      # Operator chose to go back. Re-run the top-level menu so they can pick
      # a different action (Assess & Plan vs. Assess + Run), then loop back
      # here for mode selection. The my.cnf conversion is NOT re-offered —
      # the operator already answered that prompt earlier in the flow.
      prompt_top_level_action
      continue
    fi
    case "$MODE" in
      staged)
        if [[ -z "$STAGED_PHASE" ]]; then
          if ! prompt_staged_phase; then continue; fi
        fi
        break ;;
      *) break ;;
    esac
  done
}

# Echo a "tail -f run.log in another terminal" hint before the orchestrator
# kicks off a long-running phase. The orchestrator captures script stdout to
# run.log only — script output is silent on the user's terminal until the
# whole run completes. On a large database the script appears hung. The hint
# tells the user how to watch live progress in another shell.
print_progress_hint() {
  local run_dir="$1"
  local run_log="${run_dir}/run.log"
  echo "    Live progress: tail -f $run_log"
  # two_step also writes sqldata's own progress + manifest under the run dir;
  # it's a second live tracker, useful for watching batch/chunk progress.
  if [[ "${MODE:-}" == "two_step" ]]; then
    echo "    sqldata load progress + manifest: ${run_dir}/sqldata/"
  fi
}

# Top-level action menu. Asks the operator what they want to do before any
# other prompting (mode selection, source/target creds, etc). Only shown when
# the operator invoked the launcher with no CLI phase flag — --assess, --plan,
# and --run are atomic and bypass this menu entirely (they set PHASE_MODE
# directly during arg parsing).
#
# Sets PHASE_MODE to one of:
#   "assess_plan" - choice 1: run assess + plan phases, stop before run. New
#                   composite phase added in 1.2.2; not exposed as a CLI flag
#                   because CLI flags remain atomic (one phase each).
#   "all"         - choice 2: existing default flow (assess -> plan -> run with
#                   confirms between phases). PHASE_MODE is already "all" when
#                   we enter this function; we leave it unchanged.
# Choice 'q' exits the script cleanly.
prompt_top_level_action() {
  local choice
  while true; do
    cat <<'EOF'

Direct invocation (bypasses this menu):
  ./mariadb-migrator --assess    Run the assessment phase only
  ./mariadb-migrator --plan      Run the planning phase only
  ./mariadb-migrator --run       Run the migration execution phase only
  ./mariadb-migrator --help      Show full usage and mode descriptions

What would you like to do?
  1) Assess & Plan    Inspect source and target, validate connectivity and
                      compatibility, and produce an assessment report and the
                      migration plan. No data is moved.
  2) Assess + Run     Assess the source, then proceed to the full migration
                      (plan + run, with confirm steps between phases).
  q) Quit
EOF
    read -r -p "Enter choice [1, 2, q, Enter=2]: " choice
    case "$choice" in
      1)
        PHASE_MODE="assess_plan"
        echo "==> Selected: Assess & Plan (no run)"
        return 0
        ;;
      ""|2)
        # PHASE_MODE stays "all" — the existing default flow.
        echo "==> Selected: Assess + Run (full migration with confirms)"
        return 0
        ;;
      q|Q)
        echo "==> Exiting."
        exit 0
        ;;
      *)
        echo "Invalid choice. Please enter 1, 2, or q."
        ;;
    esac
  done
}

# Convert MySQL my.cnf to MariaDB format via mariadb-migrate-config-file. Non-fatal.
migrate_mysql_config_file() {
  local mig_bin="${MARIADB_MIGRATE_CONFIG_FILE_BIN:-mariadb-migrate-config-file}"
  local src_cnf out_cnf resolved_bin

  echo ""
  echo "==> Optional: convert an existing MySQL my.cnf to MariaDB format"
  echo "    (uses ${mig_bin} with --fix-all --print)"

  if ! confirm_proceed "Convert a MySQL my.cnf to MariaDB format now?" "n"; then
    echo "==> Skipping config file conversion."
    return 0
  fi

  # Resolve binary: name on PATH or full path. Expand leading ~.
  mig_bin="$(prompt "Path to mariadb-migrate-config-file (name on PATH or full path)" "$mig_bin")"
  mig_bin="${mig_bin/#\~/$HOME}"

  if [[ "$mig_bin" == */* ]]; then
    if [[ ! -x "$mig_bin" ]]; then
      echo "WARNING: '$mig_bin' is not executable or does not exist. Skipping config file conversion."
      return 0
    fi
    resolved_bin="$mig_bin"
  else
    if ! command -v "$mig_bin" >/dev/null 2>&1; then
      echo "WARNING: '$mig_bin' not found on PATH. Skipping config file conversion."
      return 0
    fi
    resolved_bin="$mig_bin"
  fi

  src_cnf="$(prompt "Path to existing MySQL my.cnf" "$HOME/my.cnf")"
  src_cnf="${src_cnf/#\~/$HOME}"
  if [[ ! -f "$src_cnf" ]]; then
    echo "WARNING: MySQL config file not found at '$src_cnf'. Skipping config file conversion."
    return 0
  fi

  out_cnf="$(prompt "Output path for the converted MariaDB config" "$HOME/mariadb-migrated.cnf")"
  out_cnf="${out_cnf/#\~/$HOME}"

  if [[ -e "$out_cnf" ]]; then
    if ! confirm_proceed "Output file '$out_cnf' already exists. Overwrite?"; then
      echo "==> Skipping config file conversion (user chose not to overwrite)."
      return 0
    fi
  fi

  echo "==> Running: $resolved_bin --fix-all $src_cnf --print > $out_cnf"
  local rc=0
  "$resolved_bin" --fix-all "$src_cnf" --print > "$out_cnf" || rc=$?

  if [[ $rc -ne 0 ]]; then
    echo "WARNING: $resolved_bin exited with status $rc. The output file may be incomplete."
    echo "         Review '$out_cnf' and/or re-run the command manually."
    return 0
  fi

  if [[ ! -s "$out_cnf" ]]; then
    echo "WARNING: Converted config file '$out_cnf' is empty. Please inspect the source my.cnf."
    return 0
  fi

  echo "==> Converted config written to: $out_cnf"
  ls -l "$out_cnf" || true
  echo "==> Please review this file before using it to start the new MariaDB instance."
  export MARIADB_MIGRATED_CNF="$out_cnf"
  export MARIADB_MIGRATE_CONFIG_FILE_BIN="$resolved_bin"
}

# Endpoint preflight (one_step / two_step / binlog): client + connectivity + flavor.
DB_CLIENT=""

ensure_db_client() {
  if command -v mariadb >/dev/null 2>&1; then
    DB_CLIENT="mariadb"
  elif command -v mysql >/dev/null 2>&1; then
    DB_CLIENT="mysql"
  else
    cat <<'EOF'

ERROR: No database client binary found on PATH.

This script needs the 'mariadb' client to test connectivity to your source
and target databases before the migration begins. Please install it, then
re-run this script.

Install instructions:

  RHEL / CentOS / Rocky / Alma:
      sudo dnf install -y mariadb
      # (or, older: sudo yum install -y mariadb)

  Debian / Ubuntu:
      sudo apt-get update
      sudo apt-get install -y mariadb-client

  SLES / openSUSE:
      sudo zypper install -y mariadb-client

  macOS (Homebrew):
      brew install mariadb

  Official MariaDB repositories:
      https://mariadb.com/downloads/

Verify after install:
      mariadb --version

EOF
    exit 1
  fi

  local version_line
  version_line="$("$DB_CLIENT" --version 2>/dev/null | head -1)"
  echo "==> DB client detected: $DB_CLIENT  ($version_line)"
  export DB_CLIENT
}

# Run SQL via $DB_CLIENT. Sets DB_QUERY_STDOUT/STDERR/RC.
DB_QUERY_STDOUT=""
DB_QUERY_STDERR=""
DB_QUERY_RC=0
db_run_query() {
  local host="$1" port="$2" user="$3" pass="$4" sql="$5"
  local stderr_file
  local -a args=(
    -h"$host" -P"$port" -u"$user"
    --connect-timeout=10
    --batch --skip-column-names
  )
  if [[ "$DB_CLIENT" == "mariadb" ]]; then
    args+=(--ssl-verify-server-cert=OFF)
  fi
  stderr_file="$(mktemp)"
  DB_QUERY_STDOUT="$(MYSQL_PWD="$pass" "$DB_CLIENT" "${args[@]}" \
    -e "$sql" 2>"$stderr_file")" && DB_QUERY_RC=0 || DB_QUERY_RC=$?
  DB_QUERY_STDERR="$(cat "$stderr_file" 2>/dev/null || true)"
  rm -f "$stderr_file"
  return $DB_QUERY_RC
}

test_source_endpoint() {
  local version short_version repro
  echo "==> Testing source connectivity ($SRC_HOST:$SRC_PORT as '$SRC_ADMIN_USER')..."

  if [[ "$DB_CLIENT" == "mariadb" ]]; then
    repro="mariadb -h $SRC_HOST -P $SRC_PORT -u $SRC_ADMIN_USER -p --ssl-verify-server-cert=OFF"
  else
    repro="mysql -h $SRC_HOST -P $SRC_PORT -u $SRC_ADMIN_USER -p"
  fi

  # Connectivity check via SELECT 1.
  if ! db_run_query "$SRC_HOST" "$SRC_PORT" "$SRC_ADMIN_USER" "$SRC_ADMIN_PASS" "SELECT 1;"; then
    local diag="${DB_QUERY_STDERR:-$DB_QUERY_STDOUT}"
    cat <<EOF

ERROR: Could not connect to source database at $SRC_HOST:$SRC_PORT as '$SRC_ADMIN_USER'.

Client output:
$(printf '    %s\n' "$diag")

Please verify connectivity independently before retrying. From this host, run:

    $repro

Once that command connects and prints a server prompt, return here to retry.

Common causes:
  - Wrong host, port, username, or password.
  - TLS / self-signed certificate rejected. With a recent mariadb client, try:
        mariadb -h $SRC_HOST -u $SRC_ADMIN_USER -p --ssl-verify-server-cert=OFF
    or with the mysql client:
        mysql  -h $SRC_HOST -u $SRC_ADMIN_USER -p
  - MySQL bind-address is 127.0.0.1 — server is not listening on the network.
      On source:  grep bind-address /etc/my.cnf /etc/mysql/my.cnf 2>/dev/null
  - Firewall is blocking port $SRC_PORT between this host and $SRC_HOST.
      Try:  nc -vz $SRC_HOST $SRC_PORT
  - User '$SRC_ADMIN_USER' is not granted access from this host.
      On source:  SELECT user, host FROM mysql.user WHERE user='$SRC_ADMIN_USER';
EOF
    return 1
  fi

  # Version check in a separate query for clean parsing.
  if ! db_run_query "$SRC_HOST" "$SRC_PORT" "$SRC_ADMIN_USER" "$SRC_ADMIN_PASS" "SELECT VERSION();"; then
    cat <<EOF

ERROR: Connected to source at $SRC_HOST:$SRC_PORT but could not retrieve version.

Client output:
$(printf '    %s\n' "${DB_QUERY_STDERR:-$DB_QUERY_STDOUT}")
EOF
    return 1
  fi

  version="$(printf "%s\n" "$DB_QUERY_STDOUT" | tr -d '\r' | grep -E '^[0-9]+\.[0-9]+' | head -1)"
  if [[ -z "$version" ]]; then
    version="$(printf "%s\n" "$DB_QUERY_STDOUT" | tr -d '\r' | grep -Ev '^(WARNING|NOTE):' | head -1)"
  fi
  if [[ -z "$version" ]]; then
    cat <<EOF

ERROR: Source at $SRC_HOST:$SRC_PORT returned no parseable version.

Raw client stdout:
$(printf '    %s\n' "${DB_QUERY_STDOUT:-<empty>}")
Raw client stderr:
$(printf '    %s\n' "${DB_QUERY_STDERR:-<empty>}")
EOF
    return 1
  fi

  if printf "%s" "$version" | grep -iq 'mariadb'; then
    cat <<EOF

ERROR: Source at $SRC_HOST:$SRC_PORT reports it is MariaDB ($version).
       This script migrates FROM MySQL TO MariaDB. The source must be MySQL.
       Please verify you entered the correct source host.
EOF
    return 1
  fi

  short_version="$(printf "%s" "$version" | sed -E 's/^([0-9]+(\.[0-9]+){1,2}).*/\1/')"
  SRC_VERSION_DETECTED="$version"
  SRC_VERSION_SHORT="$short_version"
  export SRC_VERSION_DETECTED SRC_VERSION_SHORT

  # Brief ack only; full "Source ready" banner is printed after DB existence check.
  echo "==> Source connection OK (detected MySQL $short_version)."
  return 0
}

