      echo "==> Offline acknowledgment supplied via STAGED_CONFIRM_OFFLINE."
    fi
  fi

  # For load_only: prompt for STAGED_DUMP_DIR. Auto-detect the most recent
  # artifacts/run_staged_*/dumps with a manifest.txt as the default, so the
  # common "dump now, load later, same host" workflow is one Enter press.
  if [[ "$STAGED_PHASE" == "load_only" ]]; then
