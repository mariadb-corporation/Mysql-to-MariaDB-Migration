# Returns 0 if the current MODE requires the full endpoint preflight
# (source connectivity + MySQL check, target connectivity + MariaDB check).
needs_endpoint_preflight() {
  [[ "$MODE" == "one_step" || "$MODE" == "two_step" || "$MODE" == "binlog" || "$MODE" == "staged" ]]
}

# Side-specific predicates for staged-mode phase awareness:
#   - load_only skips source-side preflight (no source connection)
#   - dump_only skips target-side preflight (no target connection)
# Non-staged modes that need preflight pass through both.
needs_source_endpoint_preflight() {
  needs_endpoint_preflight || return 1
  [[ "$MODE" == "staged" && "$STAGED_PHASE" == "load_only" ]] && return 1
  return 0
}

needs_target_endpoint_preflight() {
  needs_endpoint_preflight || return 1
  [[ "$MODE" == "staged" && "$STAGED_PHASE" == "dump_only" ]] && return 1
  return 0
}

# For MySQL 8.4+ sources in replication-based modes (binlog, replace_slave),
# verify an upstream mysqldump >= 8.4 is available. mariadb-dump and pre-8.4
# mysqldump issue SHOW MASTER STATUS to capture binlog coordinates, which 8.4
# servers reject (only SHOW BINARY LOG STATUS is accepted). The downstream
# 14_binlog_seed.sh exits with the same hint, but firing here means the user
# learns about it before being prompted for target creds, replication user,
# config-file conversion, etc. — and well before any artifact directory is
# created (which is what causes resume to short-circuit later).
#
# Returns 0 if compatible (or check not applicable). Prints a multi-line
# error and returns 1 if the source is 8.4+ and no upstream mysqldump 8.4+
# can be found via $MARIADB_DUMP_BIN or PATH.
verify_dump_binary_for_8_4_source() {
  [[ "$MODE" == "binlog" || "$MODE" == "replace_slave" ]] || return 0

  local v_short="${SRC_VERSION_SHORT:-}"
  [[ -z "$v_short" ]] && return 0

  local major minor
  major="${v_short%%.*}"
  minor="${v_short#*.}"; minor="${minor%%.*}"
  if [[ "${major:-0}" -lt 8 ]] || { [[ "${major:-0}" -eq 8 ]] && [[ "${minor:-0}" -lt 4 ]]; }; then
    return 0
  fi

  local cand ver_line ver v_major v_minor upstream_path=""
  for cand in "${MARIADB_DUMP_BIN:-}" "mysqldump"; do
    [[ -z "$cand" ]] && continue
    [[ "$(basename "$cand")" == "mariadb-dump" ]] && continue
    command -v "$cand" >/dev/null 2>&1 || continue
    ver_line="$("$cand" --version 2>/dev/null || true)"
    if printf "%s" "$ver_line" | grep -iq 'mariadb'; then
      continue
    fi
    ver="$(printf "%s" "$ver_line" | sed -nE 's/.*Ver +([0-9]+\.[0-9]+).*/\1/p' | head -1)"
    [[ -z "$ver" ]] && ver="$(printf "%s" "$ver_line" | grep -oE '[0-9]+\.[0-9]+' | head -1)"
    v_major="${ver%%.*}"
    v_minor="${ver#*.}"; v_minor="${v_minor%%.*}"
    if [[ "${v_major:-0}" -gt 8 ]] || { [[ "${v_major:-0}" -eq 8 ]] && [[ "${v_minor:-0}" -ge 4 ]]; }; then
      upstream_path="$(command -v "$cand")"
      break
    fi
  done

  if [[ -n "$upstream_path" ]]; then
    echo "==> Dump tool: $upstream_path  (upstream mysqldump, compatible with 8.4 source)"
    return 0
  fi

  cat >&2 <<EOF

ERROR: Source is MySQL ${SRC_VERSION_DETECTED:-8.4+} (>= 8.4) and $MODE mode requires
       an upstream MySQL mysqldump >= 8.4 to capture binlog coordinates.
       mariadb-dump and pre-8.4 mysqldump both issue SHOW MASTER STATUS,
       which 8.4 servers no longer accept.

       To fix: download the MySQL 8.4 client tools from
         https://dev.mysql.com/downloads/mysql/
       extract, then export the path to its mysqldump:
         export MARIADB_DUMP_BIN=/path/to/mysql-8.4/bin/mysqldump

       Verify with:
         "\$MARIADB_DUMP_BIN" --version
       The output must contain "Ver 8.4" or higher and must NOT contain "MariaDB".

       Re-run this script after exporting MARIADB_DUMP_BIN.

EOF
  return 1
}

# Verify SRC_DBS_INPUT databases exist on source. Returns 1 on missing (caller re-prompts).
source_dbs_exist_check() {
  if [[ -z "${SRC_DBS_INPUT:-}" ]]; then
    return 0
  fi

  echo "==> Verifying requested database(s) exist on source ($SRC_HOST:$SRC_PORT)..."

  if ! db_run_query "$SRC_HOST" "$SRC_PORT" "$SRC_ADMIN_USER" "$SRC_ADMIN_PASS" "SHOW DATABASES;"; then
    echo "WARNING: Could not list databases on source. Skipping existence check."
    echo "         (The main migration will fail clearly if the databases are missing.)"
    return 0
  fi

  # Parse SRC_DBS_INPUT (comma-separated) and trim each name.
  local -a requested=()
  local raw_name
  local IFS_saved="$IFS"
  IFS=','
  local -a raw_list=( $SRC_DBS_INPUT )
  IFS="$IFS_saved"
  for raw_name in "${raw_list[@]}"; do
    raw_name="$(printf "%s" "$raw_name" | xargs)"
    [[ -n "$raw_name" ]] && requested+=("$raw_name")
  done

  local -a missing=()
  local db
  for db in "${requested[@]}"; do
    # Exact match against the database list to avoid e.g. 'app' matching 'myapp'.
    if ! printf "%s\n" "$DB_QUERY_STDOUT" | tr -d '\r' | grep -Fxq -- "$db"; then
      missing+=("$db")
    fi
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    local list_cmd
    if [[ "$DB_CLIENT" == "mariadb" ]]; then
      list_cmd="mariadb -h $SRC_HOST -P $SRC_PORT -u $SRC_ADMIN_USER -p --ssl-verify-server-cert=OFF -e 'SHOW DATABASES;'"
    else
      list_cmd="mysql -h $SRC_HOST -P $SRC_PORT -u $SRC_ADMIN_USER -p -e 'SHOW DATABASES;'"
    fi
    echo ""
    echo "ERROR: The following database(s) do NOT exist on the source ($SRC_HOST:$SRC_PORT):"
    local m
    for m in "${missing[@]}"; do
      echo "       - $m"
    done
    echo ""
    echo "       Check the spelling and re-enter. To list available databases on source:"
    echo ""
    echo "           $list_cmd"
    return 1
  fi

  echo "==> OK: all requested database(s) found on source."
  return 0
}

# --- Source-side compatibility gates ----------------------------------------
# Run after source DB verification and before target prompts. Each mode's
# helper queries the source and either returns 0 (continue) or emits an
# advisory and returns non-zero (caller re-prompts the mode menu). Modes
# without known source-side blockers fall through with no checks.
#
# To add a new mode check:
#   1. Define check_<mode>_source_compat() — query source, return 0/1
#      and emit advisory on failure.
#   2. Add a case branch to run_source_side_compatibility_checks.
#   3. Mirror the check in scripts/00_preflight_<mode>.sh and in
#      orchestrator/checks.py for non-interactive callers.

# Source-side compatibility check for binlog mode. Composes two sub-checks:
#   1. JSON columns — reuses the canonical sql/checks/json_columns.sql query
#      (shared with the assess-phase precheck bundle).
#   2. binlog_format = ROW — inline SHOW VARIABLES query (no shared SQL file;
#      the query is a one-liner and the preflight + assess do their own
#      inline checks).
# Both sub-checks run; findings accumulate; if either fails, a single
# composed advisory is printed and the function returns non-zero. The
# assess gate and the run-phase preflight enforce the same checks
# independently; this is the operator-friendly early stop so failures
# surface before target credentials are requested.
check_binlog_source_compat() {
  local repo_root json_sql_file
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  json_sql_file="${repo_root}/sql/checks/json_columns.sql"

  local json_offenders=""
  local bad_fmt=""

  # --- JSON column sub-check ---
  if [[ ! -r "$json_sql_file" ]]; then
    echo "WARNING: cannot read $json_sql_file; skipping early JSON-column check."
    echo "         (The assess and preflight gates will still enforce this.)"
  else
    local json_sql; json_sql="$(cat "$json_sql_file")"
    echo "==> Checking source schemas for JSON columns..."
    if db_run_query "$SRC_HOST" "$SRC_PORT" "$SRC_ADMIN_USER" "$SRC_ADMIN_PASS" "$json_sql"; then
      # Parse SRC_DBS_INPUT into selected[] for scope filtering.
      local -a selected=()
      local raw_name
      local IFS_saved="$IFS"
      IFS=','
      local -a raw_list=( $SRC_DBS_INPUT )
      IFS="$IFS_saved"
      for raw_name in "${raw_list[@]}"; do
        raw_name="$(printf "%s" "$raw_name" | xargs)"
        [[ -n "$raw_name" ]] && selected+=("$raw_name")
      done
      if [[ ${#selected[@]} -gt 0 ]]; then
        json_offenders="$(printf "%s\n" "$DB_QUERY_STDOUT" | awk -F'\t' \
            -v sel="$(IFS='|'; echo "${selected[*]}")" '
          BEGIN { n = split(sel, a, "|"); for (i=1;i<=n;i++) s[a[i]] = 1 }
          $1 in s { printf "  %s.%s.%s\n", $1, $2, $3 }
        ')"
      fi
    else
      echo "WARNING: JSON-column query failed; skipping early JSON-column check."
      echo "         (The assess and preflight gates will still enforce this.)"
    fi
  fi

  # --- binlog_format sub-check (inline query, no shared SQL file) ---
  echo "==> Checking source binlog_format..."
  if db_run_query "$SRC_HOST" "$SRC_PORT" "$SRC_ADMIN_USER" "$SRC_ADMIN_PASS" \
                  "SHOW VARIABLES LIKE 'binlog_format';"; then
    local current_fmt
    current_fmt="$(printf "%s\n" "$DB_QUERY_STDOUT" | awk -F'\t' 'NR==1 {print toupper($2)}')"
    if [[ -n "$current_fmt" && "$current_fmt" != "ROW" ]]; then
      bad_fmt="$current_fmt"
    fi
  else
    echo "WARNING: binlog_format query failed; skipping early binlog_format check."
    echo "         (The assess and preflight gates will still enforce this.)"
  fi

  # --- Compose advisory ---
  if [[ -z "$json_offenders" && -z "$bad_fmt" ]]; then
    echo "==> OK: source is compatible with replication mode."
    return 0
  fi

  echo ""
  echo "ERROR: Source is not compatible with replication mode."
  echo ""

  if [[ -n "$json_offenders" ]]; then
    echo "Detected JSON columns:"
    echo "$json_offenders"
    echo ""
    echo "JSON column types are not supported for online replication-based migration."
    echo "Please use one of the offline migration modes:"
    echo ""
    echo "  - Serial Streaming Copy"
    echo "  - Parallel Streaming Copy"
    echo "  - Offline Copy"
    echo ""
  fi

  if [[ -n "$bad_fmt" ]]; then
    echo "Source binlog_format is '$bad_fmt'. Replication mode requires 'ROW'."
    echo ""
    echo "To remediate, set the following in the source MySQL configuration"
    echo "(e.g. /etc/my.cnf or /etc/mysql/my.cnf) and restart the source server:"
    echo ""
    echo "  [mysqld]"
    echo "  binlog_format = ROW"
    echo ""
  fi

  return 1
}

# Dispatcher. Routes to the per-mode source-compat check, or returns 0
# for modes with no known source-side blockers.
run_source_side_compatibility_checks() {
  case "$MODE" in
    binlog) check_binlog_source_compat ;;
    *) return 0 ;;
  esac
}

