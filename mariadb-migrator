    if compgen -G "artifacts/run_staged_*/dumps/manifest.txt" >/dev/null 2>&1; then
      autodetected="$(ls -1dt artifacts/run_staged_*/dumps 2>/dev/null | head -1)"
    fi
    STAGED_DUMP_DIR="$(prompt "Path to existing dump directory" "${autodetected}")"
    if [[ -z "$STAGED_DUMP_DIR" ]]; then
      echo "ERROR: STAGED_DUMP_DIR is required for load_only."
      exit 1
    fi
    if [[ ! -f "${STAGED_DUMP_DIR}/manifest.txt" ]]; then
      echo "ERROR: ${STAGED_DUMP_DIR}/manifest.txt not found."
      exit 1
    fi
    export STAGED_DUMP_DIR
  fi

  # For dump_only: there's no target. Force INSTALL_TARGET_MARIADB=0 so the
  # target_install phase no-ops cleanly via the existing gate in
  # 23_install_mariadb.sh, and downstream scripts don't ask for target creds.
  if [[ "$STAGED_PHASE" == "dump_only" ]]; then
    INSTALL_TARGET_MARIADB="0"
    echo "==> dump_only: target install disabled (no target in this phase)."
  fi

  export STAGED_PHASE
  export STAGED_COMPRESS STAGED_PV STAGED_PARALLEL
  echo "==> Staged phase: $STAGED_PHASE"
fi

