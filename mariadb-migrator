  # chunked loading is now native to sqldata and on by default, so there is
  # no variant to select. TWO_STEP_VARIANT is accepted-but-ignored for one
  # release so a stale value in the environment or migration.yaml doesn't
  # cause a surprise; it will be dropped entirely in a future release.
  # (For a clean break with no deprecation window, delete this whole block.)
  if [[ -n "${TWO_STEP_VARIANT:-}" ]]; then
