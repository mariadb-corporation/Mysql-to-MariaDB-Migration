prompt() {
  local label="$1"
  local def="${2:-}"
  local var
  if [[ -n "$def" ]]; then
    read -r -p "$label [$def]: " var
    printf "%s" "${var:-$def}"
  else
    read -r -p "$label: " var
    printf "%s" "$var"
  fi
}

prompt_secret() {
  local label="$1"
  local var
  read -r -s -p "$label: " var
  printf "\n"
  printf "%s" "$var"
}

confirm_proceed() {
  local label="$1"
  local default_ans="${2:-y}"
  local ans
  ans="$(prompt "$label (y/n)" "$default_ans")"
  ans="$(printf "%s" "$ans" | tr '[:upper:]' '[:lower:]')"
  [[ "$ans" == "y" ]]
}

# Echo a "tail -f run.log in another terminal" hint before the orchestrator
# kicks off a long-running phase. The orchestrator captures script stdout to
# run.log only — script output is silent on the user's terminal until the
# whole run completes. On a large database the script appears hung. The hint
# tells the user how to watch live progress in another shell.
print_progress_hint() {
  local run_dir="$1"
  local run_log="${run_dir}/run.log"
  echo "    Live progress: tail -f $run_log"
}

# Convert MySQL my.cnf to MariaDB format via mariadb-migrate-config-file. Non-fatal.
migrate_mysql_config_file() {
  local mig_bin="${MARIADB_MIGRATE_CONFIG_FILE_BIN:-mariadb-migrate-config-file}"
  local src_cnf out_cnf resolved_bin

  echo ""
  echo "==> Optional: convert an existing MySQL my.cnf to MariaDB format"
  echo "    (uses ${mig_bin} with --fix-all --print)"

  if ! confirm_proceed "Convert a MySQL my.cnf to MariaDB format now?" "n"; then
    echo "==> Skipping config file conversion."
    return 0
  fi

  # Resolve binary: name on PATH or full path. Expand leading ~.
  mig_bin="$(prompt "Path to mariadb-migrate-config-file (name on PATH or full path)" "$mig_bin")"
  mig_bin="${mig_bin/#\~/$HOME}"

  if [[ "$mig_bin" == */* ]]; then
    if [[ ! -x "$mig_bin" ]]; then
      echo "WARNING: '$mig_bin' is not executable or does not exist. Skipping config file conversion."
      return 0
    fi
    resolved_bin="$mig_bin"
  else
    if ! command -v "$mig_bin" >/dev/null 2>&1; then
      echo "WARNING: '$mig_bin' not found on PATH. Skipping config file conversion."
      return 0
    fi
    resolved_bin="$mig_bin"
  fi

  src_cnf="$(prompt "Path to existing MySQL my.cnf" "$HOME/my.cnf")"
  src_cnf="${src_cnf/#\~/$HOME}"
  if [[ ! -f "$src_cnf" ]]; then
    echo "WARNING: MySQL config file not found at '$src_cnf'. Skipping config file conversion."
    return 0
  fi

  out_cnf="$(prompt "Output path for the converted MariaDB config" "$HOME/mariadb-migrated.cnf")"
  out_cnf="${out_cnf/#\~/$HOME}"

  if [[ -e "$out_cnf" ]]; then
    if ! confirm_proceed "Output file '$out_cnf' already exists. Overwrite?"; then
      echo "==> Skipping config file conversion (user chose not to overwrite)."
      return 0
    fi
  fi

  echo "==> Running: $resolved_bin --fix-all $src_cnf --print > $out_cnf"
  local rc=0
  "$resolved_bin" --fix-all "$src_cnf" --print > "$out_cnf" || rc=$?

  if [[ $rc -ne 0 ]]; then
    echo "WARNING: $resolved_bin exited with status $rc. The output file may be incomplete."
    echo "         Review '$out_cnf' and/or re-run the command manually."
    return 0
  fi

  if [[ ! -s "$out_cnf" ]]; then
    echo "WARNING: Converted config file '$out_cnf' is empty. Please inspect the source my.cnf."
    return 0
  fi

  echo "==> Converted config written to: $out_cnf"
  ls -l "$out_cnf" || true
  echo "==> Please review this file before using it to start the new MariaDB instance."
  export MARIADB_MIGRATED_CNF="$out_cnf"
  export MARIADB_MIGRATE_CONFIG_FILE_BIN="$resolved_bin"
}

# Endpoint preflight (one_step / two_step / binlog): client + connectivity + flavor.
DB_CLIENT=""

ensure_db_client() {
  if command -v mariadb >/dev/null 2>&1; then
    DB_CLIENT="mariadb"
  elif command -v mysql >/dev/null 2>&1; then
    DB_CLIENT="mysql"
  else
    cat <<'EOF'

ERROR: No database client binary found on PATH.

This script needs the 'mariadb' client to test connectivity to your source
and target databases before the migration begins. Please install it, then
re-run this script.

Install instructions:

  RHEL / CentOS / Rocky / Alma:
      sudo dnf install -y mariadb
      # (or, older: sudo yum install -y mariadb)

  Debian / Ubuntu:
      sudo apt-get update
      sudo apt-get install -y mariadb-client

  SLES / openSUSE:
      sudo zypper install -y mariadb-client

  macOS (Homebrew):
      brew install mariadb

  Official MariaDB repositories:
      https://mariadb.com/downloads/

Verify after install:
      mariadb --version

EOF
    exit 1
  fi

  local version_line
  version_line="$("$DB_CLIENT" --version 2>/dev/null | head -1)"
  echo "==> DB client detected: $DB_CLIENT  ($version_line)"
  export DB_CLIENT
}

# Run SQL via $DB_CLIENT. Sets DB_QUERY_STDOUT/STDERR/RC.
DB_QUERY_STDOUT=""
DB_QUERY_STDERR=""
DB_QUERY_RC=0
db_run_query() {
  local host="$1" port="$2" user="$3" pass="$4" sql="$5"
  local stderr_file
  local -a args=(
    -h"$host" -P"$port" -u"$user"
    --connect-timeout=10
    --batch --skip-column-names
  )
  if [[ "$DB_CLIENT" == "mariadb" ]]; then
    args+=(--ssl-verify-server-cert=OFF)
  fi
  stderr_file="$(mktemp)"
  DB_QUERY_STDOUT="$(MYSQL_PWD="$pass" "$DB_CLIENT" "${args[@]}" \
    -e "$sql" 2>"$stderr_file")" && DB_QUERY_RC=0 || DB_QUERY_RC=$?
  DB_QUERY_STDERR="$(cat "$stderr_file" 2>/dev/null || true)"
  rm -f "$stderr_file"
  return $DB_QUERY_RC
}

test_source_endpoint() {
  local version short_version repro
  echo "==> Testing source connectivity ($SRC_HOST:$SRC_PORT as '$SRC_ADMIN_USER')..."

  if [[ "$DB_CLIENT" == "mariadb" ]]; then
    repro="mariadb -h $SRC_HOST -P $SRC_PORT -u $SRC_ADMIN_USER -p --ssl-verify-server-cert=OFF"
  else
    repro="mysql -h $SRC_HOST -P $SRC_PORT -u $SRC_ADMIN_USER -p"
  fi

  # Connectivity check via SELECT 1.
  if ! db_run_query "$SRC_HOST" "$SRC_PORT" "$SRC_ADMIN_USER" "$SRC_ADMIN_PASS" "SELECT 1;"; then
    local diag="${DB_QUERY_STDERR:-$DB_QUERY_STDOUT}"
    cat <<EOF

ERROR: Could not connect to source database at $SRC_HOST:$SRC_PORT as '$SRC_ADMIN_USER'.

Client output:
$(printf '    %s\n' "$diag")

Please verify connectivity independently before retrying. From this host, run:

    $repro

Once that command connects and prints a server prompt, return here to retry.

Common causes:
  - Wrong host, port, username, or password.
  - TLS / self-signed certificate rejected. With a recent mariadb client, try:
        mariadb -h $SRC_HOST -u $SRC_ADMIN_USER -p --ssl-verify-server-cert=OFF
    or with the mysql client:
        mysql  -h $SRC_HOST -u $SRC_ADMIN_USER -p
  - MySQL bind-address is 127.0.0.1 — server is not listening on the network.
      On source:  grep bind-address /etc/my.cnf /etc/mysql/my.cnf 2>/dev/null
  - Firewall is blocking port $SRC_PORT between this host and $SRC_HOST.
      Try:  nc -vz $SRC_HOST $SRC_PORT
  - User '$SRC_ADMIN_USER' is not granted access from this host.
      On source:  SELECT user, host FROM mysql.user WHERE user='$SRC_ADMIN_USER';
EOF
    return 1
  fi

  # Version check in a separate query for clean parsing.
  if ! db_run_query "$SRC_HOST" "$SRC_PORT" "$SRC_ADMIN_USER" "$SRC_ADMIN_PASS" "SELECT VERSION();"; then
    cat <<EOF

ERROR: Connected to source at $SRC_HOST:$SRC_PORT but could not retrieve version.

Client output:
$(printf '    %s\n' "${DB_QUERY_STDERR:-$DB_QUERY_STDOUT}")
EOF
    return 1
  fi

  version="$(printf "%s\n" "$DB_QUERY_STDOUT" | tr -d '\r' | grep -E '^[0-9]+\.[0-9]+' | head -1)"
  if [[ -z "$version" ]]; then
    version="$(printf "%s\n" "$DB_QUERY_STDOUT" | tr -d '\r' | grep -Ev '^(WARNING|NOTE):' | head -1)"
  fi
  if [[ -z "$version" ]]; then
    cat <<EOF

ERROR: Source at $SRC_HOST:$SRC_PORT returned no parseable version.

Raw client stdout:
$(printf '    %s\n' "${DB_QUERY_STDOUT:-<empty>}")
Raw client stderr:
$(printf '    %s\n' "${DB_QUERY_STDERR:-<empty>}")
EOF
    return 1
  fi

  if printf "%s" "$version" | grep -iq 'mariadb'; then
    cat <<EOF

ERROR: Source at $SRC_HOST:$SRC_PORT reports it is MariaDB ($version).
       This script migrates FROM MySQL TO MariaDB. The source must be MySQL.
       Please verify you entered the correct source host.
EOF
    return 1
  fi

  short_version="$(printf "%s" "$version" | sed -E 's/^([0-9]+(\.[0-9]+){1,2}).*/\1/')"
  SRC_VERSION_DETECTED="$version"
  SRC_VERSION_SHORT="$short_version"
  export SRC_VERSION_DETECTED SRC_VERSION_SHORT

  # Brief ack only; full "Source ready" banner is printed after DB existence check.
  echo "==> Source connection OK (detected MySQL $short_version)."
  return 0
}

test_target_endpoint() {
  local version short_version repro
  echo "==> Testing target connectivity ($TGT_HOST:$TGT_PORT as '$TGT_ADMIN_USER')..."

  if [[ "$DB_CLIENT" == "mariadb" ]]; then
    repro="mariadb -h $TGT_HOST -P $TGT_PORT -u $TGT_ADMIN_USER -p --ssl-verify-server-cert=OFF"
  else
    repro="mysql -h $TGT_HOST -P $TGT_PORT -u $TGT_ADMIN_USER -p"
  fi

  # Step 1: connectivity.
  if ! db_run_query "$TGT_HOST" "$TGT_PORT" "$TGT_ADMIN_USER" "$TGT_ADMIN_PASS" "SELECT 1;"; then
    local diag="${DB_QUERY_STDERR:-$DB_QUERY_STDOUT}"
    cat <<EOF

ERROR: Could not connect to target database at $TGT_HOST:$TGT_PORT as '$TGT_ADMIN_USER'.

Client output:
$(printf '    %s\n' "$diag")

Please verify connectivity independently before retrying. From this host, run:

    $repro

Once that command connects and prints a MariaDB prompt, return here to retry.

Common causes:
  - TLS / self-signed certificate rejected. With a recent mariadb client, use:
        mariadb -h $TGT_HOST -u $TGT_ADMIN_USER -p --ssl-verify-server-cert=OFF
  - MariaDB service is not running on $TGT_HOST.
      On target:  systemctl status mariadb
  - Wrong host, port, username, or password.
  - MariaDB bind-address is 127.0.0.1 — server is not listening on the network.
      On target:  grep bind-address /etc/my.cnf.d/*.cnf /etc/mysql/mariadb.conf.d/*.cnf 2>/dev/null
  - Firewall is blocking port $TGT_PORT between this host and $TGT_HOST.
      Try:  nc -vz $TGT_HOST $TGT_PORT
  - User '$TGT_ADMIN_USER' is not granted access from this host.
      On target:  SELECT user, host FROM mysql.user WHERE user='$TGT_ADMIN_USER';
EOF
    return 1
  fi

  # Step 2: version in a separate query.
  if ! db_run_query "$TGT_HOST" "$TGT_PORT" "$TGT_ADMIN_USER" "$TGT_ADMIN_PASS" "SELECT VERSION();"; then
    cat <<EOF

ERROR: Connected to target at $TGT_HOST:$TGT_PORT but could not retrieve version.

Client output:
$(printf '    %s\n' "${DB_QUERY_STDERR:-$DB_QUERY_STDOUT}")
EOF
    return 1
  fi

  version="$(printf "%s\n" "$DB_QUERY_STDOUT" | tr -d '\r' | grep -E '^[0-9]+\.[0-9]+' | head -1)"
  if [[ -z "$version" ]]; then
    version="$(printf "%s\n" "$DB_QUERY_STDOUT" | tr -d '\r' | grep -Ev '^(WARNING|NOTE):' | head -1)"
  fi
  if [[ -z "$version" ]]; then
    cat <<EOF

ERROR: Target at $TGT_HOST:$TGT_PORT returned no parseable version.

Raw client stdout:
$(printf '    %s\n' "${DB_QUERY_STDOUT:-<empty>}")
Raw client stderr:
$(printf '    %s\n' "${DB_QUERY_STDERR:-<empty>}")
EOF
    return 1
  fi

  # Reject if the server does not identify as MariaDB.
  if ! printf "%s" "$version" | grep -iq 'mariadb'; then
    cat <<EOF

ERROR: Target at $TGT_HOST:$TGT_PORT reports: $version
       This does not appear to be MariaDB. The target MUST be MariaDB for
       this migration. Please verify you entered the correct target host.
EOF
    return 1
  fi

  short_version="$(printf "%s" "$version" | sed -E 's/^([0-9]+(\.[0-9]+){1,2}).*/\1/')"
  TGT_VERSION_DETECTED="$version"
  TGT_VERSION_SHORT="$short_version"
  export TGT_VERSION_DETECTED TGT_VERSION_SHORT

  echo "==> Target connection OK (detected MariaDB $short_version)."
  return 0
}

# Returns 0 if the current MODE requires the full endpoint preflight
# (source connectivity + MySQL check, target connectivity + MariaDB check).
needs_endpoint_preflight() {
  [[ "$MODE" == "one_step" || "$MODE" == "two_step" || "$MODE" == "binlog" || "$MODE" == "staged" ]]
}

# Side-specific predicates for staged-mode phase awareness:
#   - load_only skips source-side preflight (no source connection)
#   - dump_only skips target-side preflight (no target connection)
# Non-staged modes that need preflight pass through both.
needs_source_endpoint_preflight() {
  needs_endpoint_preflight || return 1
  [[ "$MODE" == "staged" && "$STAGED_PHASE" == "load_only" ]] && return 1
  return 0
}

needs_target_endpoint_preflight() {
  needs_endpoint_preflight || return 1
  [[ "$MODE" == "staged" && "$STAGED_PHASE" == "dump_only" ]] && return 1
  return 0
}

# For MySQL 8.4+ sources in replication-based modes (binlog, replace_slave),
# verify an upstream mysqldump >= 8.4 is available. mariadb-dump and pre-8.4
# mysqldump issue SHOW MASTER STATUS to capture binlog coordinates, which 8.4
# servers reject (only SHOW BINARY LOG STATUS is accepted). The downstream
# 14_binlog_seed.sh exits with the same hint, but firing here means the user
# learns about it before being prompted for target creds, replication user,
# config-file conversion, etc. — and well before any artifact directory is
# created (which is what causes resume to short-circuit later).
#
# Returns 0 if compatible (or check not applicable). Prints a multi-line
# error and returns 1 if the source is 8.4+ and no upstream mysqldump 8.4+
# can be found via $MARIADB_DUMP_BIN or PATH.
verify_dump_binary_for_8_4_source() {
  [[ "$MODE" == "binlog" || "$MODE" == "replace_slave" ]] || return 0

  local v_short="${SRC_VERSION_SHORT:-}"
  [[ -z "$v_short" ]] && return 0

  local major minor
  major="${v_short%%.*}"
  minor="${v_short#*.}"; minor="${minor%%.*}"
  if [[ "${major:-0}" -lt 8 ]] || { [[ "${major:-0}" -eq 8 ]] && [[ "${minor:-0}" -lt 4 ]]; }; then
    return 0
  fi

  local cand ver_line ver v_major v_minor upstream_path=""
  for cand in "${MARIADB_DUMP_BIN:-}" "mysqldump"; do
    [[ -z "$cand" ]] && continue
    [[ "$(basename "$cand")" == "mariadb-dump" ]] && continue
    command -v "$cand" >/dev/null 2>&1 || continue
    ver_line="$("$cand" --version 2>/dev/null || true)"
    if printf "%s" "$ver_line" | grep -iq 'mariadb'; then
      continue
    fi
    ver="$(printf "%s" "$ver_line" | sed -nE 's/.*Ver +([0-9]+\.[0-9]+).*/\1/p' | head -1)"
    [[ -z "$ver" ]] && ver="$(printf "%s" "$ver_line" | grep -oE '[0-9]+\.[0-9]+' | head -1)"
    v_major="${ver%%.*}"
    v_minor="${ver#*.}"; v_minor="${v_minor%%.*}"
    if [[ "${v_major:-0}" -gt 8 ]] || { [[ "${v_major:-0}" -eq 8 ]] && [[ "${v_minor:-0}" -ge 4 ]]; }; then
      upstream_path="$(command -v "$cand")"
      break
    fi
  done

  if [[ -n "$upstream_path" ]]; then
    echo "==> Dump tool: $upstream_path  (upstream mysqldump, compatible with 8.4 source)"
    return 0
  fi

  cat >&2 <<EOF

ERROR: Source is MySQL ${SRC_VERSION_DETECTED:-8.4+} (>= 8.4) and $MODE mode requires
       an upstream MySQL mysqldump >= 8.4 to capture binlog coordinates.
       mariadb-dump and pre-8.4 mysqldump both issue SHOW MASTER STATUS,
       which 8.4 servers no longer accept.

       To fix: download the MySQL 8.4 client tools from
         https://dev.mysql.com/downloads/mysql/
       extract, then export the path to its mysqldump:
         export MARIADB_DUMP_BIN=/path/to/mysql-8.4/bin/mysqldump

       Verify with:
         "\$MARIADB_DUMP_BIN" --version
       The output must contain "Ver 8.4" or higher and must NOT contain "MariaDB".

       Re-run this script after exporting MARIADB_DUMP_BIN.

EOF
  return 1
}

# Verify SRC_DBS_INPUT databases exist on source. Returns 1 on missing (caller re-prompts).
source_dbs_exist_check() {
  if [[ -z "${SRC_DBS_INPUT:-}" ]]; then
    return 0
  fi

  echo "==> Verifying requested database(s) exist on source ($SRC_HOST:$SRC_PORT)..."

  if ! db_run_query "$SRC_HOST" "$SRC_PORT" "$SRC_ADMIN_USER" "$SRC_ADMIN_PASS" "SHOW DATABASES;"; then
    echo "WARNING: Could not list databases on source. Skipping existence check."
    echo "         (The main migration will fail clearly if the databases are missing.)"
    return 0
  fi

  # Parse SRC_DBS_INPUT (comma-separated) and trim each name.
  local -a requested=()
  local raw_name
  local IFS_saved="$IFS"
  IFS=','
  local -a raw_list=( $SRC_DBS_INPUT )
  IFS="$IFS_saved"
  for raw_name in "${raw_list[@]}"; do
    raw_name="$(printf "%s" "$raw_name" | xargs)"
    [[ -n "$raw_name" ]] && requested+=("$raw_name")
  done

  local -a missing=()
  local db
  for db in "${requested[@]}"; do
    # Exact match against the database list to avoid e.g. 'app' matching 'myapp'.
    if ! printf "%s\n" "$DB_QUERY_STDOUT" | tr -d '\r' | grep -Fxq -- "$db"; then
      missing+=("$db")
    fi
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    local list_cmd
    if [[ "$DB_CLIENT" == "mariadb" ]]; then
      list_cmd="mariadb -h $SRC_HOST -P $SRC_PORT -u $SRC_ADMIN_USER -p --ssl-verify-server-cert=OFF -e 'SHOW DATABASES;'"
    else
      list_cmd="mysql -h $SRC_HOST -P $SRC_PORT -u $SRC_ADMIN_USER -p -e 'SHOW DATABASES;'"
    fi
    echo ""
    echo "ERROR: The following database(s) do NOT exist on the source ($SRC_HOST:$SRC_PORT):"
    local m
    for m in "${missing[@]}"; do
      echo "       - $m"
    done
    echo ""
    echo "       Check the spelling and re-enter. To list available databases on source:"
    echo ""
    echo "           $list_cmd"
    return 1
  fi

  echo "==> OK: all requested database(s) found on source."
  return 0
}

