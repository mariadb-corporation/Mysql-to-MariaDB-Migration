prompt() {
  local label="$1"
  local def="${2:-}"
  local var
  if [[ -n "$def" ]]; then
    read -r -p "$label [$def]: " var
    printf "%s" "${var:-$def}"
  else
    read -r -p "$label: " var
    printf "%s" "$var"
  fi
}

prompt_secret() {
  local label="$1"
  local var
  read -r -s -p "$label: " var
  printf "\n"
  printf "%s" "$var"
}

confirm_proceed() {
  local label="$1"
  local ans
  ans="$(prompt "$label (y/n)" "y")"
  ans="$(printf "%s" "$ans" | tr '[:upper:]' '[:lower:]')"
  [[ "$ans" == "y" ]]
}

# Convert a MySQL my.cnf to MariaDB format using mariadb-migrate-config-file.
# The produced file is for the user to review before bringing up the new MariaDB.
# Non-fatal: on any failure we warn and continue so the main migration still runs.
migrate_mysql_config_file() {
  local mig_bin="${MARIADB_MIGRATE_CONFIG_FILE_BIN:-mariadb-migrate-config-file}"
  local src_cnf out_cnf resolved_bin

  echo ""
  echo "==> Optional: convert an existing MySQL my.cnf to MariaDB format"
  echo "    (uses ${mig_bin} with --fix-all --print)"

  if ! confirm_proceed "Convert a MySQL my.cnf to MariaDB format now?"; then
    echo "==> Skipping config file conversion."
    return 0
  fi

  # Resolve the binary. Accept either a name on PATH or an explicit path
  # (e.g. \$HOME/server/bld/extra/mariadb-migrate-config-file).
  mig_bin="$(prompt "Path to mariadb-migrate-config-file (name on PATH or full path)" "$mig_bin")"
  # Expand a leading ~ so '~/server/bld/extra/...' works.
  mig_bin="${mig_bin/#\~/$HOME}"

  if [[ "$mig_bin" == */* ]]; then
    if [[ ! -x "$mig_bin" ]]; then
      echo "WARNING: '$mig_bin' is not executable or does not exist. Skipping config file conversion."
      return 0
    fi
    resolved_bin="$mig_bin"
  else
    if ! command -v "$mig_bin" >/dev/null 2>&1; then
      echo "WARNING: '$mig_bin' not found on PATH. Skipping config file conversion."
      return 0
    fi
    resolved_bin="$mig_bin"
  fi

  src_cnf="$(prompt "Path to existing MySQL my.cnf" "$HOME/my.cnf")"
  src_cnf="${src_cnf/#\~/$HOME}"
  if [[ ! -f "$src_cnf" ]]; then
    echo "WARNING: MySQL config file not found at '$src_cnf'. Skipping config file conversion."
    return 0
  fi

  out_cnf="$(prompt "Output path for the converted MariaDB config" "$HOME/mariadb-migrated.cnf")"
  out_cnf="${out_cnf/#\~/$HOME}"

  # Make sure we can write the output (and avoid clobbering silently).
  if [[ -e "$out_cnf" ]]; then
    if ! confirm_proceed "Output file '$out_cnf' already exists. Overwrite?"; then
      echo "==> Skipping config file conversion (user chose not to overwrite)."
      return 0
    fi
  fi

  echo "==> Running: $resolved_bin --fix-all $src_cnf --print > $out_cnf"
  # Run outside of set -e so a non-zero exit is reported but non-fatal.
  set +e
  "$resolved_bin" --fix-all "$src_cnf" --print > "$out_cnf"
  local rc=$?
  set -e

  if [[ $rc -ne 0 ]]; then
    echo "WARNING: $resolved_bin exited with status $rc. The output file may be incomplete."
    echo "         Review '$out_cnf' and/or re-run the command manually."
    return 0
  fi

  if [[ ! -s "$out_cnf" ]]; then
    echo "WARNING: Converted config file '$out_cnf' is empty. Please inspect the source my.cnf."
    return 0
  fi

  echo "==> Converted config written to: $out_cnf"
  ls -l "$out_cnf" || true
  echo "==> Please review this file before using it to start the new MariaDB instance."
  # Export so downstream phases (orchestrator, planners) can read it if useful.
  export MARIADB_MIGRATED_CNF="$out_cnf"
  export MARIADB_MIGRATE_CONFIG_FILE_BIN="$resolved_bin"
}


PHASE_MODE="all"
if [[ $# -gt 0 ]]; then
  case "${1:-}" in
    --assess) PHASE_MODE="assess" ;;
    --plan) PHASE_MODE="plan" ;;
    --run) PHASE_MODE="run" ;;
