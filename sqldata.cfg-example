-- mariadb-mtk Data options (contact us at  https://mariadb-community.slack.com/archives/C0BEPVC8PC6 to request a new option)

-- Please note that all configuration options can be specified in the command line as well.

-- DDL Options 
--------------

-- Set yes to to migrate table definitions, or no to not migrate 
-- DDL statements executed depends on -topt option (CREATE; DROP and CREATE TABLE, or TRUNCATE TABLE)
-ddl_tables=

-- Set yes to to migrate constraints (this is default), or no to not migrate 
-- Please note that if -topt=truncate or -topt=none is specified, constraints are not migrated
-constraints=

-- Set yes to to migrate indexes (this is default), or no to not migrate 
-- Please note that if -topt=truncate or -topt=none is specified, indexes are not migrated
-indexes=

-- Set upper to convert object names (tables i.e.) to upper case in DDL scripts. Set lower to convert to lower case.
-- This option does not apply for object defined in table name mapping file (see sqlines_tmap.txt)
-object_name_case=

-- Set upper to convert column names to upper case in DDL scripts. Set lower to convert to lower case.
-- This option does not apply for columns defined in column name mapping file (see sqlines_cmap.txt)
-column_name_case=

-- Set characters to quote column identifiers. 
-- For example, specify "" for double quotes (or \"\" if you use the option in command line)
-column_name_quotes=

-- Set characters to quote object identifiers (schemas, table etc). 
-- For example, specify "" for double quotes (or \"\" if you use the option in command line)
-object_name_quotes=

-- Define the start length for CHAR(n) columns to be converted to VARCHAR(n).
-- For example, if -char_to_varchar_length=255 then all CHAR columns with the length equal or exceeding 255 are converted to VARCHAR.
-char_to_varchar_length=

-- Set the start value for IDENTITY (AUTO_INCREMENT) columns. By default, the start value is taken as the next value
-- for the corresponding source table
-identity_start=

-- The number of restart attempts for DDL statements that failed with a deadlock error:
-- SQL Server: "Transaction (Process ID <num>) was deadlocked on lock resources with another process
-- and has been chosen as the deadlock victim. Rerun the transaction."
-- MySQL, MariaDB: "Deadlock found when trying to get lock; try restarting transaction"
-- PostgreSQL: "ERROR: deadlock detected. DETAIL: Process waits for AccessExclusiveLock on object"
-- Default value is 10
-deadlock_restart_attempts=

-- Data Options
---------------

-- Set yes to to migrate data (this is default), or no to not migrate 
-data=

-- When loading data into existing tables (without recreation), and no SELECT expression or query is not defined,
-- the default option -load_existing_columns_order=target means that the target table defines the order and list of columns to be loaded.
-- Use -load_existing_columns_order=source to use the column order of the source table instead.
-load_existing_columns_order=target

-- The maximum number of rows in read/write batch, by default it is defined by the buffer size divided by the table row size
-batch_max_rows=10000

-- Enable concurrent transfer within a single table or partition for large tables (intra-table and intra-partition parallelism)
-large_tables_parallel=yes

-- The number of rows when a non-partitioned table or partition is considered large and transferred in multiple concurrent sessions
-- The option defines the estimated chunk size in rows. The actual number of concurrent sessions is determined by the -ss option
-large_tables_rows=1000000

-- The table size in MB (megabytes) when a non-partitioned table or partition is considered large and transferred in multiple concurrent sessions
-- The option defines the estimated chunk size in MB. The actual number of concurrent sessions is determined by the -ss option 
-large_tables_mb=100

-- Percentage of resources to allocate for large table transfers. Large tables are selected first within allocated resources. 
-large_tables_resources_pct=70

-- Fixed-size buffer (in bytes) for reading LOB values. Increase the buffer size if truncation errors occur on LOB columns, 
-- or set it to 0 to read each LOB value using a separate API call
-lob_bind_buffer=10000000

-- The minimum number of buffers to allocate for reading LOB data 
-lob_bind_min_buffers=30

-- When converting from ASCII or UTF16/UCS-2 character sets in the source database to UTF8 i.e. in the target database depending on 
-- the actual data you may need greater storage size. And vice versa converting in opposite direction you may require smaller storage size.
-- This parameter specifies the length change ratio. If the source length is 100, and ratio is 1.1 then the target length will be 110 
-char_length_ratio=

-- Set year value YYYY (4 digits) to convert DATETIME values to NULL if their year is less or equal to the specified value. 
-- For example, set -datetime_year_lte_to_null=0002 to convert all DATETIME values like '0001-01-01 00:00:00' or '0002-01-01 00:00:00' to NULL
-datetime_year_lte_to_null=

-- The number of restart attempts for data transfer and DDL statements that failed with a transient error (e.g., timeout, lost connection).
-- Default value is 10. Set -restart_attempts=0 to disable restarts.
-restart_attempts=

-- MariaDB options
------------------

-- Path to MariaDB library including the file name. For example, for MariaDB Connector C on Windows:
--   -mariadb_lib=C:\Program Files\MariaDB\MariaDB Connector C 64-bit\lib\libmariadb.dll 
-- By default, on Windows the tool tries to load libmariadb.dll library from PATH; if not found the tool tries to use MySQL connector libmysql.dll
-mariadb_lib=

-- Set the character set for LOAD DATA INFILE command
-mariadb_load_data_character_set=binary

-- Define how to handle duplicate rows (based on PRIMARY KEY or UNIQUE constraints). If REPLACE is specified, the new rows replace the existing
-- rows with the same key value. If IGNORE is specified, new rows with duplicate keys are ignored.
-- By default, an error occurs when a duplicate key value is found.
-mariadb_load_data_duplicates=

-- Set the session SQL_MODE, if not empty the tool runs SET @@SQL_MODE = '<flags>'; to set SQL_MODE flags (comma-separated list)
-- For example, -mariadb_set_sql_mode=NO_AUTO_VALUE_ON_ZERO,NO_ZERO_DATE
-mariadb_set_sql_mode=

-- Append flags to the session SQL_MODE, if not empty the tool runs SET @@SQL_MODE = CONCAT(@@SQL_MODE, ',<new flags>'); to add new flags
-- For example, -mariadb_append_sql_mode=NO_AUTO_VALUE_ON_ZERO
-mariadb_append_sql_mode=

-- Disable or enable binary logging for the connection (the client must have the SUPER privilege for this operation). 
-- By default, MariaDB default is used. 
-mariadb_set_sql_log_bin=0

-- Run SET UNIQUE_CHECKS=value at the beginning of each session, not executed if no value set (MariaDB as target)
-mariadb_set_unique_checks=0

-- Set global max_allowed_packet option to the specified value (use only values in multiples of 1024, for example, 1073741824 for 1GB)
-- Use this option when you receive 'MySQL has gone away' error during the data load
-mariadb_max_allowed_packet=

-- Disable or enable server certificate verification (MYSQL_OPT_SSL_VERIFY_SERVER_CERT option), possible values: 
-- 0 (disabled, default) and 1 (enabled)
-mariadb_ssl_verify_server_cert=0

-- MySQL options
----------------

-- Path to MySQL library including the file name. For example, for MySQL Connector C on Windows:
--   -mysql_lib=C:\Program Files\MySQL\MySQL Server 8.0\lib\libmysql.dll 
-- By default, on Windows the tool tries to load libmysql.dll library from PATH

-- IMPORATANT NOTE. 
-- If you run SQLines Data on MySQL 8.x server host and do not use MySQL Connector C, make sure that 
-- both C:\Program Files\MySQL\MySQL Server 8.0\lib and C:\Program Files\MySQL\MySQL Server 8.0\bin are added to the PATH 
-- environment variable.
-- The reason is that although libmysql.dll in located in lib directory, it still needs 
-- libssl-1_1-x64.dll and libcrypto-1_1-x64.dll located in the bin directory.
-- For more details, see https://www.sqlines.com/sqldata_mysql_connection
-mysql_lib=

-- Create the specified database if it does not exist 
-mysql_create_db=yes

-- Set the character set for the connection and the tables that are created (latin1, utf8mb4 e.g.)
-mysql_set_character_set=utf8mb4

-- Set the collation for the connection and the tables that are created (latin1_bin, utf8mb4_bin e.g.) 
-mysql_set_collation=utf8mb4_bin

-- Set the character set for the LOAD DATA INFILE command
-mysql_load_data_character_set=binary

-- Define how to handle duplicate rows (based on PRIMARY KEY or UNIQUE constraints). If REPLACE is specified, the new rows replace the existing
-- rows with the same key value. If IGNORE is specified, new rows with duplicate keys are ignored.
-- By default, an error occurs when a duplicate key value is found.
-mysql_load_data_duplicates=

-- By default, data is loaded in a single transaction. However, when binary logging is enabled or a Galera cluster is used, 
-- large imports can trigger 'Maximum writeset size exceeded' errors. Use this option to split the import into multiple chunks 
-- by specifying the data size (in MB) per LOAD DATA INFILE command.
-mysql_load_data_chunks_mb=

-- The size of VARCHAR columns when they are mapped to TEXT instead of VARCHAR(size) 
-- This helps prevent errors:
-- "Row size too large. The maximum row size for the used table type, not counting BLOBs, is 65535. 
--  This includes storage overhead, check the manual. You have to change some columns to TEXT or BLOBs"
-mysql_varchar_to_text_size=100

-- Run SET FOREIGN_KEY_CHECKS=value at the beginning of each session, not executed if no value set (MySQL as target)
-mysql_set_foreign_key_checks=0

-- Disable or enable binary logging for the connection (the client must have the SUPER privilege for this operation). 
-- By default, MySQL default is used. 
-mysql_set_sql_log_bin=0

-- SSL connection mode (--ssl-mode MySQL option), possible values: DISABLED, PREFERRED (default), REQUIRED, VERIFY_CA, VERIFY_IDENTITY
-mysql_ssl_mode=DISABLED

-- SSL private key file (--ssl-key MySQL option), the absolute path to the file
-mysql_ssl_key=

-- SSL certificate file (--ssl-cert MySQL option), the absolute path to the file in PEM format
-mysql_ssl_cert=

-- SSL CA file (--ssl-ca option of MySQL CLI), the absolute path to the file in PEM format
-mysql_ssl_ca=

-- Collate used for data validation (latin1_bin, utf8mb4_bin, utf8mb3_bin). Use _bin or _cs collates to order values ABCabc instead of AaBbCc
-mysql_validation_collate=utf8mb4_bin

-- SQL Server options
---------------------

-- Path to SQL Server client library including the file name. For example, for SQL Server on Windows:
--   -sql_lib=C:\Windows\system32\msodbcsql17.dll
-- For example, for SQL Server on Linux: 
--   -sql_lib=/opt/microsoft/msodbcsql17/lib64/libmsodbcsql-17.7.so.2.1
-- By default, on Windows the tool tries to find the library from Windows Registry. For Linux you have to set this option
-- See also https://www.sqlines.com/sqldata_sql_server_connection
-sql_lib=

-- SQL Server driver name. Set it only if -sql_lib is specified. For example: ODBC Driver 17 for SQL Server
-sql_driver=

-- Additional options to add to the SQL Server connection string e.g. Encrypt=Yes;TrustServerCertificate=Yes;
-sql_conn_string=

-- Create the specified database if it does not exist 
-sql_create_db=yes

-- Create the specified schema if it does not exist 
-sql_create_schema=yes

-- When exporting data from a SQL Server database, use Unicode for CHAR and VARCHAR columns, default is yes
-- If No is specified, the tool will use the database collation, but note that even if the database collation includes _UTF8 in its name
-- the data may be still converted to single-byte client locale, so you can see '???' characters
-sql_unicode_char=yes

-- Codepage for input data (BCP -C option), for example, 65001 for UTF-8 (this is default), ACP or 1252	for Windows-1252 (ISO 1252) 
-- 28591 for ISO 8859-1 Latin 1 (Western European ISO), 28605 for ISO 8859-15 Latin 9
-bcp_codepage=

-- Oracle options
-----------------

-- Path to Oracle OCI library including the file name. For example, for Oracle on Windows:
--   -oci_lib=C:\oraclexe\app\oracle\product\11.2.0\server\bin\oci.dll
-- By default, on Windows the tool tries to load oci.dll library from PATH; if not found the tool tries to search Windows registry to find Oracle client installations
-- See also https://www.sqlines.com/sqldata_oracle_connection
-oci_lib=

-- NLS_LANG setting to use for Oracle connection e.g. AMERICAN_AMERICA.WE8MSWIN1252, AMERICAN_AMERICA.AL32UTF8, AMERICAN_AMERICA.WE8ISO8859P1 etc.
-oracle_nls_lang=

-- Set to yes to use the Oracle SQL*Loader OCI in-memory API for direct path loading, improving load performance into Oracle 
-ora_direct_path_load=yes

-- Perform a consistent read across all tables, ensuring the export reflects data from a single point in time 
-- rather than mix of different states. 
-- Retrieve data from the database as it existed at the specified SCN. If 'runtime' value is specified 
-- the tool reads the current SCN before starting the export. Alternatively, you can specify a particular SCN number 
-- up to which the data should be exported. The SCN used for export is stored in sqldata_ora_scn.txt file in the output directory. 
-- Running SELECT AS OF SCN requires the FLASHBACK TABLE privilege; otherwise, Oracle raises the error: "ORA-01031: insufficient privileges"
-- If the value is not set, no consistent export is used
-ora_flashback_scn=

-- PostgreSQL options
---------------------

-- Path to PostgreSQL C API libpq library including the file name (libpq.so.5 on Linux and libpq.dll on Windows)
-- For example, for PostgreSQL on Windows:
--   -pg_lib=C:\Program Files\PostgreSQL\17\bin\libpq.dll
-- By default, on Windows the tool tries to load libpq.dll library from PATH 
-- (if not found the tool tries to search Windows registry to find PostgreSQL client installations); 
-- on Linux the library path should be specified in LD_LIBRARY_PATH
-- See also http://www.sqlines.com/sqldata_postgresql_connection
-pg_lib=

-- Set client encoding (you can also use PGCLIENTENCODING environment variable) i.e. UTF8, WIN1252, EUC-TW (Traditional Chinese, Taiwan) etc.
-pg_client_encoding=

-- Create the specified schema if it does not exist 
-pg_create_schema=yes

-- When migrating to PostgreSQL, use the COLLATE clause with the specified value for character columns in CREATE TABLE statements
-- For example, the option can be used to specify a case-insensitive collation for columns (must exist)
--   CREATE COLLATION IF NOT EXISTS case_insensitive (provider = icu, locale = 'en-US-u-ks-level2', deterministic = false);
-pg_use_collate=

-- If -pg_use_identity=always is specified (this is the default), IDENTITY columns are migrated to GENERATED ALWAYS AS IDENTITY column property
-- If -pg_use_identity=default is specified, IDENTITY columns are migrated to GENERATED BY DEFAULT AS IDENTITY column property
-- If -pg_use_identity=no is specified, IDENTITY columns from other databases are migrated
-- to a SEQUENCE object and DEFAULT NEXTVAL('sequence') column property. 
-pg_use_identity=always

-- PostgreSQL does not allow characters with zero code in character (non-binary) data types (CHAR, VARCHAR and TEXT)
-- See https://www.sqlines.com/postgresql/zero_char_code_in_string for more details.
-- If the source value is a string (non-binary) -pg_zero_char_replace option specifies the replacement character (decimal ASCII code) 
-- i.e 32 for a blank. Use an empty value to prevent any replacement and leave the zero characters as is.
-pg_zero_char_replace=32

-- Set -pg_set_session_replication_role='replica' to disable foreign key checks for each transfer session 
-- when loading into an existing schema with referential constraints (it requires appropriate SET privilege or superuser access) 
-pg_set_session_replication_role=

-- Set -pg_truncate=CASCADE to generate TRUNCATE <tab> CASCADE statements when running a truncate operation for tables.
-- This helps prevent the error "Cannot truncate a table referenced in a foreign key constraint"
-- Important: TRUNCATE CASCADE causes deletion of rows (!), not the removal of constraints, in child tables
-pg_truncate=

-- Specifies the fillfactor option used in the generated CREATE TABLE statements
-pg_tab_fillfactor=

-- Specifies the fillfactor option used in the generated CREATE INDEX statements
-pg_idx_fillfactor=

-- IBM DB2 options
------------------

-- Codepage (you can also set the DB2CODEPAGE environment variable e.g. 1208 for UTF-8)
-db2_codepage=

-- Sybase ASE options
---------------------

-- Set characters to quote identifiers when exporting from Sybase ASE, the default is [] 
-- For example, specify "" for double quotes (or \"\" if you use the option in command line)
-sybase_ident_quotes=

-- Codepage (cp850, cp1252, iso_1, utf8 e.g.), default is utf8
-sybase_codepage=

-- Set to yes to use encrypted password handshakes with the server
-sybase_encrypted_password=

-- Sybase ASA (Sybase SQL Anywhere) options
-------------------------------------------

-- Set the client character set (UTF-8, windows-1252 e.g.), default is UTF-8
-sybase_asa_charset=

-- Set to yes to extract all character data as 2-byte Unicode (UTF-16/UCS-2)
-sybase_asa_char_as_wchar=

-- Informix options
-------------------

-- Set CLIENT_LOCALE for connection e.g. en_US.57372 for UTF-8 database, en_us.8859-15 for ISO 8859 Latin 9, en_us.819 for ISO 8859 Latin 1 etc. 
-- Note that Setnet32 and environment variable has no effect on Informix ODBC driver
-informix_client_locale=

-- Validation Options
---------------------

-- Maximum number of found not equal rows per table after which the validation stops for this table, by default no limit set
-validation_not_equal_max_rows=

-- Number of digits in the fractional part (milliseconds, microseconds e.g.) of datetime/timestamp values to validate. By default, all digits are compared
-validation_datetime_fraction=

-- Misc Options
---------------

-- Set to yes to generate trace file sqldata.trc with debug information, default is no
-trace=

-- Set to yes to create dump files containing data for tables
-trace_data=

-- Set to yes to create dump files containing differences in data found during data validation
-trace_diff_data=

-- Set the console locale e.g. en-US.1252, Turkish_Turkey.1254 to deal with national characters in identifiers if it does not work by default.
-- On Windows, you can also change the system default locale, go to Control Panel -> Region -> Administrative tab and change 
-- Current Language for non-Unicode programs (change System locale)
-console_locale=
